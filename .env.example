# ============================================================
# RoadWise AI - Local PostgreSQL/PostGIS Environment Config
# ============================================================
# Instructions:
# 1. Copy this file to '.env' in your project root or RoadWiseAI folder:
#    cp .env.example .env
# 2. Replace 'YOUR_POSTGRESQL_PASSWORD' with your local PostgreSQL 18 password.
# 3. DO NOT commit '.env' to version control or share credentials.
# ============================================================

DATABASE_URL=postgresql://postgres:YOUR_POSTGRESQL_PASSWORD@127.0.0.1:5432/gisdb
