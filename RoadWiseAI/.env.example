# ============================================================
# RoadWise AI - Local PostgreSQL/PostGIS Environment Config
# ============================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Replace 'YOUR_POSTGRESQL_PASSWORD' with your local PostgreSQL 18 password.
# 3. DO NOT commit '.env' to version control or share credentials.
# ============================================================

DATABASE_URL=postgresql://postgres:YOUR_POSTGRESQL_PASSWORD@127.0.0.1:5432/gisdb

# Flask Pilot Session Secret (Stage 7)
# Generate a secure 32-byte hex secret (e.g. via python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=YOUR_SECURE_RANDOM_SECRET_KEY_HERE

# Production / Pilot Debug Control (0 = production mode, 1 = debug mode)
FLASK_DEBUG=0

# Optional: Google Maps JavaScript API Key (Stage 5 Live Traffic View)
# Create a key in Google Cloud Console, enable "Maps JavaScript API",
# restrict to HTTP referrers (e.g. http://127.0.0.1:5000/*), and paste here.
# If omitted, the rest of the application and GIS analytics work fully.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
